# Copy this file to .env and adjust as needed.
# All values are optional; sensible defaults are applied when unset.

# --- Server ---
HOST=127.0.0.1
PORT=8000
# Comma-separated list of allowed CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---
# Directory where generated projects and the SQLite DB are stored.
# Relative paths are resolved against the repository root.
PROJECTS_DIR=projects

# --- Crawl limits (safety / scope) ---
MAX_PAGES=40
MAX_DEPTH=2
# Number of pages rendered concurrently in the browser.
PAGE_CONCURRENCY=3
# Number of assets downloaded concurrently.
ASSET_CONCURRENCY=8

# --- Asset limits (safety) ---
# Max size of a single downloaded asset, in megabytes.
MAX_ASSET_MB=25
# Total download budget per project, in megabytes.
MAX_TOTAL_MB=600

# --- Browser ---
# Headless Chromium navigation timeout (milliseconds).
NAV_TIMEOUT_MS=45000
# Run the browser with a visible window (false = headless).
HEADFUL=false

# --- Security ---
# Block requests to private / loopback / cloud-metadata addresses (SSRF guard).
BLOCK_PRIVATE_HOSTS=true

# --- Quality loop ---
# Default number of analyse->generate->compare->fix cycles.
DEFAULT_FIX_CYCLES=1

# Block analytics/ads/cookie banners/chat widgets while capturing (cleaner, faster copies)
BLOCK_TRACKERS=true
# Cross-project asset cache lifetime in hours (0 disables the cache)
ASSET_CACHE_TTL_HOURS=168

# --- Authentication (Google sign-in) ---
# The app is gated behind a Google account. Create an OAuth "Web application"
# client in Google Cloud Console and paste its credentials here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an "Authorized redirect URI" of that OAuth client.
# Prod:  https://your-domain.example/api/auth/google/callback
# Dev :  http://localhost:5173/api/auth/google/callback   (Vite proxies /api)
# Left empty, it is derived from PUBLIC_BASE_URL, then from the request origin.
OAUTH_REDIRECT_URI=
# Public origin of the deployed app (used to build the redirect URI if unset).
PUBLIC_BASE_URL=
# Secret used to sign the session cookie. Generate a long random value in prod,
# e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-insecure-change-me
# Session lifetime, in days.
SESSION_DAYS=30
# Send the session cookie only over HTTPS (set true in production).
COOKIE_SECURE=false
# Local testing WITHOUT Google credentials: enables POST /api/auth/dev-login
# and a "dev" sign-in button. Never enable this in production.
DEV_AUTH=false
